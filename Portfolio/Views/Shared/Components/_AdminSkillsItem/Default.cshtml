@model List<SkillItem>

@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}


<div class="overflow-x-auto">
    <table class="w-full text-left border-collapse">
        <thead>
            <tr class="bg-surface-container text-on-surface-variant border-b border-outline-variant">

                <th class="px-lg py-md font-label-sm uppercase tracking-wider">Yetenek Adı</th>
                <th class="px-lg py-md font-label-sm uppercase tracking-wider">Aktiflik Durumu</th>
                <th class="px-lg py-md font-label-sm uppercase tracking-wider ">Yetenek Kategorisi</th>
                <th class="px-lg py-md font-label-sm uppercase tracking-wider text-right">İşlemler</th>

            </tr>
        </thead>
        <tbody class="divide-y divide-outline-variant/30">
            @foreach (var item in Model)
            {
                <tr class="hover:bg-surface-container-lowest/50 transition-colors">
                    <td class="px-lg py-md text-on-surface-variant">@item.Name</td>
                    <td class="px-lg py-md">
                        @if (item.IsActive)
                        {
                            <span class="badge badge-success">Aktif</span>
                        }
                        else
                        {
                            <span class="badge badge-danger">Pasif</span>
                        }

                    </td>

                    <td class="px-lg py-md text-on-surface-variant"><span class="badge badge-dark">@item.Skill.Name</span></td>
                    <td class="px-lg py-md text-right">
                        <div class="flex justify-end gap-sm">
                            <a href="/SkillItem/UpdateSkillItem/@item.Id" class="p-1.5 text-on-surface-variant hover:text-primary hover:bg-surface-container rounded-md transition-all">
                                <span class="material-symbols-outlined text-[20px]">edit</span>
                            </a>
                            <a href="/SkillItem/DeleteSkillItem/@item.Id" onclick="return confirm('Silmek İstediğinize Emin Misiniz?')" class="p-1.5 text-on-surface-variant hover:text-error hover:bg-error-container/20 rounded-md transition-all">
                                <span class="material-symbols-outlined text-[20px]">delete</span>
                            </a>
                        </div>
                    </td>
                </tr>
            }


        </tbody>
    </table>
</div>
<div class="px-lg py-md bg-surface-container-lowest border-t border-outline-variant flex justify-between items-center">

    <div class="flex gap-xs">
        <button class="w-8 h-8 flex items-center justify-center border border-outline-variant rounded hover:bg-surface-container transition-all">
            <span class="material-symbols-outlined text-[18px]">chevron_left</span>
        </button>
        <button class="w-8 h-8 flex items-center justify-center bg-primary text-white rounded font-label-sm">1</button>
        <button class="w-8 h-8 flex items-center justify-center border border-outline-variant rounded hover:bg-surface-container transition-all font-label-sm">2</button>
        <button class="w-8 h-8 flex items-center justify-center border border-outline-variant rounded hover:bg-surface-container transition-all font-label-sm">3</button>
        <button class="w-8 h-8 flex items-center justify-center border border-outline-variant rounded hover:bg-surface-container transition-all">
            <span class="material-symbols-outlined text-[18px]">chevron_right</span>
        </button>
    </div>
</div>