@model List<Skill>
@{
   
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}

<section class="col-span-12 lg:col-span-12">

    @if (Model != null)
    {
        <div class="bg-surface-container-lowest border border-outline-variant rounded-xl custom-shadow overflow-hidden">
            <div class="px-lg py-md border-b border-outline-variant flex justify-between items-center">
                <h3 class="font-h3 text-h3 text-on-surface"></h3>
                <div class="flex gap-sm">
                    <button class="p-2 border border-outline-variant rounded-lg hover:bg-surface-container transition-all">
                        <span class="material-symbols-outlined text-[20px] text-on-surface-variant">filter_list</span>
                    </button>
                    <button class="p-2 border border-outline-variant rounded-lg hover:bg-surface-container transition-all">
                        <span class="material-symbols-outlined text-[20px] text-on-surface-variant">download</span>
                    </button>
                </div>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-surface-container text-on-surface-variant border-b border-outline-variant">

                            <th class="px-lg py-md font-label-sm uppercase tracking-wider">İkon Ekle</th>
                            <th class="px-lg py-md font-label-sm uppercase tracking-wider">Hizmet Adı</th>
                            <th class="px-lg py-md font-label-sm uppercase tracking-wider text-right">Açıklama</th>

                        </tr>
                    </thead>
                    <tbody class="divide-y divide-outline-variant/30">
                        @foreach (var item in Model)
                        {
                            <tr class="hover:bg-surface-container-lowest/50 transition-colors">
                                <td class="px-lg py-md text-on-surface-variant">@item.Name</td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge-active"><i class="bi bi-check-circle-fill me-1"></i>Aktif</span>
                                    }
                                    else
                                    {
                                        <span class="badge-passive"><i class="bi bi-x-circle-fill me-1"></i>Pasif</span>
                                    }
                                </td>
                                <td class="px-lg py-md text-right">
                                    <div class="flex justify-end gap-sm">
                                        <a href="/Skill/UpdateSkill/@item.Id" class="p-1.5 text-on-surface-variant hover:text-primary hover:bg-surface-container rounded-md transition-all">
                                            <span class="material-symbols-outlined text-[20px]">edit</span>
                                        </a>
                                        <a href="/Skill/DeleteSkill/@item.Id" onclick="return confirm('Silmek İstediğinize Emin Misiniz?')" class="p-1.5 text-on-surface-variant hover:text-error hover:bg-error-container/20 rounded-md transition-all">
                                            <span class="material-symbols-outlined text-[20px]">delete</span>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }


                    </tbody>
                </table>
            </div>
            <div class="px-lg py-md bg-surface-container-lowest border-t border-outline-variant flex justify-between items-center">
                <p class="text-on-surface-variant font-label-sm">Toplam 24 projeden 1-4 arası gösteriliyor</p>
                <div class="flex gap-xs">
                    <button class="w-8 h-8 flex items-center justify-center border border-outline-variant rounded hover:bg-surface-container transition-all">
                        <span class="material-symbols-outlined text-[18px]">chevron_left</span>
                    </button>
                    <button class="w-8 h-8 flex items-center justify-center bg-primary text-white rounded font-label-sm">1</button>
                    <button class="w-8 h-8 flex items-center justify-center border border-outline-variant rounded hover:bg-surface-container transition-all font-label-sm">2</button>
                    <button class="w-8 h-8 flex items-center justify-center border border-outline-variant rounded hover:bg-surface-container transition-all font-label-sm">3</button>
                    <button class="w-8 h-8 flex items-center justify-center border border-outline-variant rounded hover:bg-surface-container transition-all">
                        <span class="material-symbols-outlined text-[18px]">chevron_right</span>
                    </button>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info"><strong>Henüz Yetenek Eklenmemiş</strong></div>
        <br />

        <a href="/Skill/CreateSkill" class="btn btn-outline-dark">

            Yetenek Ekle

        </a>
    }



</section>

