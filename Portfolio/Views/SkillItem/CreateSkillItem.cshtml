@model SkillItem
@{
    ViewData["Title"] = "CreateSkillItem";
    Layout = "~/Views/AdminLayout/Layout.cshtml";
}


<form method="post">
    <label>Yetenek Adı</label>
    <input type="text" asp-for="Name" class="form-control" required>
    <br />
    <label> Yetenek</label>
    <select class="form-control" asp-for="SkillId" asp-items="@ViewBag.Skills">
        <option selected disabled="">-- Tekonoloji Seçiniz --</option>
    </select>
    <br />
    <button type="submit" class="btn btn-outline-dark">Kaydet</button>

</form>


